{
  "name": "brycecast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve:api": "node scripts/api-server.mjs",
    "serve:app": "node scripts/api-server.mjs --static=dist",
    "api:smoke": "node scripts/api-smoke.mjs",
    "test:live-readiness": "node scripts/test-live-readiness.mjs",
    "analytics:view-models:validate": "node scripts/validate-ui-view-models.mjs",
    "analytics:ui-data-package": "node scripts/build-ui-data-package.mjs",
    "analytics:ui-data-package:validate": "node scripts/validate-ui-data-package.mjs",
    "audit:sources": "node scripts/audit-sources.mjs",
    "audit:live:pressure": "node scripts/live-source-pressure-test.mjs --endpoints=all --interval-ms=1000 --iterations=30",
    "audit:live:pressure:primary": "node scripts/live-source-pressure-test.mjs --endpoints=primary --interval-ms=1000 --iterations=60",
    "weather:live": "node scripts/live-weather.mjs --track-id=track_road_america",
    "weather:live:upcoming": "node scripts/live-weather.mjs --upcoming-indy-nxt",
    "ingest:history": "node scripts/ingest-history.mjs",
    "career:import:indy-nxt": "node scripts/import-indy-nxt-career.mjs",
    "career:import:indy-nxt:refresh": "node scripts/import-indy-nxt-career.mjs --refresh --concurrency=64",
    "career:import:gb3": "node scripts/import-gb3-career.mjs",
    "career:import:gb3:refresh": "node scripts/import-gb3-career.mjs --refresh --concurrency=4",
    "career:import:gb3-2021": "node scripts/import-gb3-2021-career.mjs",
    "career:import:gb3-2021:refresh": "node scripts/import-gb3-2021-career.mjs --refresh --concurrency=4",
    "career:import:imsa": "node scripts/import-imsa-career.mjs",
    "career:import:imsa:refresh": "node scripts/import-imsa-career.mjs --refresh",
    "career:import:euroformula-2023": "node scripts/import-euroformula-2023-career.mjs",
    "career:import:euroformula-2023:refresh": "node scripts/import-euroformula-2023-career.mjs --refresh",
    "career:import:froc": "node scripts/import-froc-2024-career.mjs",
    "career:import:froc:refresh": "node scripts/import-froc-2024-career.mjs --refresh",
