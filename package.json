    "career:backfill:froc-grid-rules:refresh": "node scripts/backfill-froc-grid-rules.mjs --refresh",
    "career:import:frp-f1600": "node scripts/import-frp-f1600-career.mjs",
    "career:import:frp-f1600:refresh": "node scripts/import-frp-f1600-career.mjs --refresh --concurrency=8",
    "career:import:formula-ford-2020": "node scripts/import-formula-ford-2020-career.mjs",
    "career:import:formula-ford-2020:refresh": "node scripts/import-formula-ford-2020-career.mjs --refresh",
    "career:summary": "node scripts/summarize-career-ingestion.mjs",
    "career:coverage": "node scripts/audit-career-coverage.mjs",
    "career:test": "node scripts/test-career-data-regressions.mjs",
    "career:backfill:indy-nxt-report-details": "node scripts/backfill-indy-nxt-report-details.mjs",
    "career:backfill:indy-nxt-report-details:refresh": "node scripts/backfill-indy-nxt-report-details.mjs --refresh",
    "career:backfill:indy-nxt-session-windows": "node scripts/backfill-indy-nxt-session-windows.mjs",
    "career:backfill:indy-nxt-session-windows:refresh": "node scripts/backfill-indy-nxt-session-windows.mjs --refresh",
    "career:backfill:indy-nxt-weather": "node scripts/backfill-indy-nxt-weather.mjs",
    "career:backfill:indy-nxt-weather:refresh": "node scripts/backfill-indy-nxt-weather.mjs --refresh",
    "career:crosscheck:indy-nxt-weather-stations": "node scripts/crosscheck-indy-nxt-weather-stations.mjs",
    "career:crosscheck:indy-nxt-weather-stations:refresh": "node scripts/crosscheck-indy-nxt-weather-stations.mjs --refresh",
    "career:backfill:session-windows": "node scripts/backfill-session-windows.mjs",
    "career:backfill:session-windows:refresh": "node scripts/backfill-session-windows.mjs --refresh",
    "career:backfill:team-usa-context": "node scripts/backfill-team-usa-context.mjs",
    "career:backfill:team-usa-context:refresh": "node scripts/backfill-team-usa-context.mjs --refresh",
    "career:backfill:badger-kart-club-context": "node scripts/backfill-badger-kart-club-context.mjs",
    "career:backfill:badger-kart-club-context:refresh": "node scripts/backfill-badger-kart-club-context.mjs --refresh",
    "career:backfill:track-metadata": "node scripts/backfill-track-metadata.mjs",
    "career:backfill:track-metadata:verify": "node scripts/backfill-track-metadata.mjs --verify-source-urls",
    "career:import:all": "npm run career:import:indy-nxt && npm run career:backfill:indy-nxt-report-details && npm run career:import:gb3-2021 && npm run career:import:gb3 && npm run career:import:imsa && npm run career:import:euroformula-2023 && npm run career:import:frp-f1600 && npm run career:import:formula-ford-2020 && npm run career:import:froc && npm run career:backfill:froc-grid-rules && npm run career:backfill:session-windows && npm run career:backfill:indy-nxt-session-windows && npm run career:backfill:track-metadata && npm run career:backfill:indy-nxt-weather && npm run career:crosscheck:indy-nxt-weather-stations && npm run career:backfill:badger-kart-club-context && npm run career:backfill:team-usa-context && npm run career:validate && npm run career:summary && npm run career:coverage",
    "career:validate": "node scripts/validate-career-data.mjs",
    "probe:pov": "node scripts/probe-onboards.mjs --once",
    "probe:pov:watch": "node scripts/probe-onboards.mjs --watch --interval-ms=15000",
    "poll:race": "node scripts/race-poller.mjs --once",
    "poll:race:watch": "node scripts/race-poller.mjs --watch --interval-ms=15000",
    "qa:render": "node scripts/qa-render.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright-core": "^1.60.0"
  }
}
