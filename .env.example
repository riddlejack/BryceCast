# The recommended portfolio demo does not read this file or require secrets.
# For explicit local API development only; load environment variables yourself.
HOST=127.0.0.1
BRYCECAST_API_RUNNER_ONLY=1
BRYCECAST_ENABLE_TIMING_DOWNLOADS=0
# Generate and supply an operator token outside Git when enabling remote operations.
# BRYCECAST_OPERATOR_TOKEN=
# BRYCECAST_SQLITE_PATH=/absolute/path/to/an/offline/archive-copy.sqlite
# BRYCECAST_RUNNER_STATUS_PATH=/absolute/path/to/status.json
# BRYCECAST_ALLOWED_ORIGIN=https://your-own-site.example
